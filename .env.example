# ==============================================================================
# Saúde Familiar - Variáveis de Ambiente
# ==============================================================================

# Porta e Ambiente de Execução
PORT=8080
NODE_ENV=development

# Configurações do Backend / Storage
STORAGE_DRIVER=mock

# ==============================================================================
# Firebase Authentication - Frontend Client (Vite)
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ==============================================================================
# Google Cloud Platform / Firebase Admin Backend
# Utiliza Application Default Credentials (ADC) automaticamente no Cloud Run.
# Em desenvolvimento local com ADC, o Project ID pode ser configurado abaixo:
# ==============================================================================
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=
